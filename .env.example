# Created automatically when Neon is connected through the Vercel Marketplace.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Enable Neon Auth in the Neon Console and copy its server URL.
NEON_AUTH_BASE_URL=https://your-auth-endpoint.neonauth.example/auth

# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters
