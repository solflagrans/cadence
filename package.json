    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.1.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
